# Copy this file to `local.properties` and fill in real values.
# `local.properties` is gitignored and must NEVER be committed.

# Path to your Android SDK (Android Studio usually writes this automatically).
# Forward slashes work on Windows and avoid the backslash-escaping trap that
# Java .properties files impose.
sdk.dir=C:/Users/<you>/AppData/Local/Android/Sdk

# The school's Skolar server. Optional: leave it out for schools on the
# central server (https://app.skolarbot.com). AI keys live on that server;
# the board never holds one.
# ERP_BASE_URL=https://app.skolarbot.com
