<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="notes/" />
        <exclude domain="file" path="imports/" />
        <exclude domain="file" path="backgrounds/" />
        <exclude domain="database" path="smartboard.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="imports/" />
        <exclude domain="file" path="backgrounds/" />
    </device-transfer>
</data-extraction-rules>
