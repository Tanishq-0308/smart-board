    <!-- Notes under the cards -->
    <string name="m3d_note_cylinder">Euler\'s formula counts flat faces, so it applies to polyhedra — not to a cylinder.</string>
    <string name="m3d_note_cone">One third of the cylinder with the same r and h — three cones of water fill one cylinder.</string>
    <string name="m3d_note_sphere">Archimedes: a sphere is ⅔ of the cylinder (h = 2r) that wraps it.</string>
    <string name="m3d_note_cube">Set the height to %1$s and it becomes a cube!</string>
    <string name="m3d_note_pyramid">One third of the prism with the same base and height.</string>
