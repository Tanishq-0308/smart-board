<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A bare Material3 theme with no ActionBar. All real theming happens in
      Compose (core/ui/theme). This exists only so the Activity has a valid
      platform theme and a splash-free launch background.
    -->
    <style name="Theme.SmartBoard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/board_surface</item>
        <item name="android:statusBarColor">@color/board_chrome</item>
        <item name="android:navigationBarColor">@color/board_chrome</item>
    </style>
</resources>
